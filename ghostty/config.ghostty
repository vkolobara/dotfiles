font-family = "SauceCodePro Nerd Font"

# Built-in Kanagawa Wave matches wezterm/colors/kanagawa-wave.toml except for
# the cursor and selection, which follow the WezTerm configuration below.
theme = Kanagawa Wave
cursor-color = cell-foreground
cursor-text = cell-background
selection-background = #2d4f67
selection-foreground = #c8c093

# Start herdr inside fish in the first window, so quitting herdr leaves the shell open.
initial-command = fish -C herdr
